ADMIN_PASSWORD="PinhatechAdmin2025!"

# Chave de Sessão Segura (Altere para uma chave longa e aleatória em produção)
SECRET_KEY="pinhatech-super-secret-key-change-this-in-production-affiliate-store-2025"

# Banco de Dados (SQLite por padrão para zero custo e deploy instantâneo)
DATABASE_URL="sqlite:///./pinhatech.db"

# Canais de Divulgação VIP (Telegram e WhatsApp)
TELEGRAM_VIP_URL="https://t.me/pinhatech_ofertas"
